Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical de producción. En localhost no redirige, para poder probar con PHP embebido.
  RewriteCond %{HTTP_HOST} ^www\.panelsolarnorte\.cl$ [NC]
  RewriteRule ^ https://panelsolarnorte.cl%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^panelsolarnorte\.cl$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://panelsolarnorte.cl%{REQUEST_URI} [L,R=301]

  # Una sola URL de inicio.
  RewriteCond %{THE_REQUEST} \s/+index\.php(?:[\s?]|$) [NC]
  RewriteRule ^index\.php$ / [R=301,L]

  # Sin slash final en páginas (los directorios reales, como /panel/, se conservan).
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  RewriteRule ^(?:config\.php|router\.php)$ - [F,L]
  RewriteRule ^data(/|$) - [F,L]
  RewriteRule ^includes(/|$) - [F,L]
  RewriteRule \.(?:sqlite|sqlite-journal|sqlite-wal|sqlite-shm|log)$ - [F,L]

  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^(servicios|guias)/?$ hub.php?tipo=$1 [L,QSA]
  RewriteRule ^instaladores/?$ instaladores.php [L,QSA]
  RewriteRule ^(net-billing-chile|kit-solar-off-grid-parcelas|bombeo-solar-agricola|paneles-solares-empresas)/?$ silo.php?slug=$1 [L,QSA]
  RewriteRule ^guias/([a-z0-9-]+)/?$ guia.php?slug=$1 [L,QSA]
  RewriteRule ^paneles-solares-([a-z0-9-]+)/?$ comuna.php?slug=$1 [L,QSA]
</IfModule>

<FilesMatch "^(config\.php|router\.php)$">
  Require all denied
</FilesMatch>

<FilesMatch "\.(sqlite|sqlite-journal|sqlite-wal|sqlite-shm|log)$">
  Require all denied
</FilesMatch>

ErrorDocument 404 /404.php

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header set Content-Security-Policy "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'"
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(svg|png|jpg|jpeg|webp|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>
